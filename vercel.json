{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": { "runtime": "nodejs22.x" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.ts" },
    { "source": "/br/:city/:slug", "destination": "/index.html" },
    { "source": "/profissional/:slug", "destination": "/index.html" },
    { "source": "/:slug", "destination": "/index.html" },
    { "source": "/buscar", "destination": "/index.html" },
    { "source": "/comunidades", "destination": "/index.html" },
    { "source": "/comunidade/:slug", "destination": "/index.html" },
    { "source": "/lojas", "destination": "/index.html" },
    { "source": "/relatorios", "destination": "/index.html" },
    { "source": "/relatorios/:slug", "destination": "/index.html" },
    { "source": "/painel", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] }
  ]
}
